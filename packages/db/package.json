{
	"name": "@feedreader/db",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./client": "./src/client.ts",
		"./schema": "./src/schema/index.ts",
		"./schema/*": "./src/schema/*.ts",
		"./types": "./src/types.ts"
	},
	"scripts": {
		"db:generate": "drizzle-kit generate",
		"db:migrate": "dotenv -e ../../.env -e ../../.env.docker -e ../../.env.local -- drizzle-kit migrate",
		"db:seed": "dotenv -e ../../.env -e ../../.env.docker -e ../../.env.local -- tsx src/seed.ts",
		"db:reset": "dotenv -e ../../.env -e ../../.env.docker -e ../../.env.local -- tsx src/reset.ts",
		"db:studio": "dotenv -e ../../.env -e ../../.env.docker -e ../../.env.local -- drizzle-kit studio",
		"type-check": "tsc --noEmit",
		"clean": "rm -rf node_modules .cache"
	},
	"dependencies": {
		"better-auth": "^1.7.1",
		"drizzle-orm": "^0.45.2",
		"postgres": "^3.4.9"
	},
	"devDependencies": {
		"@types/node": "^26.2.0",
		"dotenv-cli": "^11.0.0",
		"drizzle-kit": "^0.31.10",
		"tsx": "^4.23.12",
		"typescript": "^7.0.2"
	}
}
