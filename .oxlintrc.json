{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["import", "typescript", "unicorn", "react"],
	"jsPlugins": [
		"./tooling/oxlint-plugin-no-use-effect/index.js",
		"@shadcn/lint"
	],
	"categories": {
		"correctness": "error",
		"suspicious": "warn",
		"perf": "warn",
		"style": "off",
		"pedantic": "off",
		"restriction": "off",
		"nursery": "off"
	},
	"rules": {
		"no-console": "off",
		"no-unused-vars": "warn",
		"no-await-in-loop": "off",
		"no-underscore-dangle": "off",
		"no-shadow": "off",
		"react/jsx-key": "error",
		"react/react-in-jsx-scope": "off",
		"unicorn/no-array-sort": "off",
		"unicorn/no-empty-file": "off",
		"unicorn/no-new-array": "off",
		"import/no-named-as-default": "off",
		"import/no-unassigned-import": [
			"warn",
			{
				"allow": ["**/jest-dom/**"]
			}
		],
		"typescript/no-explicit-any": "warn",
		"no-use-effect/no-use-effect": "error",
		"shadcn/no-restyle": [
			"error",
			{
				"allow": ["layout"]
			}
		],
		"shadcn/no-raw-colors": "error",
		"shadcn/no-arbitrary-values": "error",
		"shadcn/no-inline-styles": "error",
		"shadcn/no-unknown-classes": "error",
		"shadcn/require-static-classes": "error",
		"react/forbid-elements": [
			"error",
			{
				"forbid": [
					{
						"element": "button",
						"message": "use <Button> from @/components/ui/button; add a variant or size there when none fits"
					},
					{
						"element": "input",
						"message": "use <Input>, <Switch> or another @/components/ui primitive"
					},
					{
						"element": "select",
						"message": "use <Select> from @/components/ui/select"
					},
					{
						"element": "textarea",
						"message": "use <Textarea> from @/components/ui/textarea"
					},
					{
						"element": "dialog",
						"message": "use <Dialog> or <AlertDialog> from @/components/ui"
					}
				]
			}
		]
	},
	"overrides": [
		{
			"files": ["**/*.test.ts", "**/*.test.tsx", "**/tests/**"],
			"rules": {
				"no-unused-vars": "off",
				"typescript/no-non-null-assertion": "off"
			}
		},
		{
			"files": ["apps/web/components/ui/**"],
			"rules": {
				"react/forbid-elements": "off",
				"shadcn/no-restyle": "off",
				"shadcn/no-arbitrary-values": "off",
				"shadcn/require-static-classes": "off"
			}
		}
	],
	"ignorePatterns": [
		"**/node_modules/**",
		"**/.cache/**",
		"**/.output/**",
		"**/.vercel/**",
		"**/.turbo/**",
		"**/dist/**",
		"**/routeTree.gen.ts",
		"packages/db/drizzle/**",
		".claude/**",
		".agents/**",
		".ralph/**"
	]
}
